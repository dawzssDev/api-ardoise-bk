# Niega acceso HTTP directo a la raíz del proyecto.
# El document root debe apuntar a /public. Si queda mal configurado,
# este archivo evita exponer código, .env y vendor.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
