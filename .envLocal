# =============================================================================
# .env.production.example — Hostinger Cloud Startup (api-ardoise.dawzss.com)
# =============================================================================
# Uso: cp .env.production.example .env  y completa los placeholders.
# Nunca subas el .env real al repositorio.
# =============================================================================

APP_NAME=Ardoise
APP_ENV=debug
APP_KEY=base64:8DVoptSM7+aU35oqZeQe850qM1uj2+xGbm+4b9BK/68=
# Generar con: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL (credenciales de hPanel → Databases) ---
# En Hostinger el host suele ser 127.0.0.1 o localhost.
# database/username tienen prefijo tipo u123456789_...
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ardoise
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Hostinger mailbox SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=soporte.dawzss@dawzss.com
MAIL_PASSWORD='S0ftw4r3$DAWZ_2026*'
MAIL_FROM_ADDRESS="soporte.dawzss@dawzss.com"
MAIL_FROM_NAME="Ardoise Soporte"

# Frontend React (origen de producción)
FRONTEND_URL=http://localhost:5173

# Orígenes CORS permitidos (separados por coma). Sin cookies / Bearer only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://100.89.243.114:5173,https://ardoise-info.dawzss.com

# # Stripe LIVE (Dashboard → Developers → API keys / Webhooks)
