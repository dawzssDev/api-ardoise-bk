# =============================================================================
# .env.production.example — Hostinger Cloud Startup (api-ardoise.dawzss.com)
# =============================================================================
# Uso: cp .env.production.example .env  y completa los placeholders.
# Nunca subas el .env real al repositorio.
# =============================================================================

APP_NAME=Ardoise
APP_ENV=production
APP_KEY=
# Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api-ardoise.dawzss.com
APP_TIMEZONE=America/Mazatlan

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL (credenciales de hPanel → Databases) ---
# En Hostinger el host suele ser 127.0.0.1 o localhost.
# database/username tienen prefijo tipo u123456789_...
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_ardoise
DB_USERNAME=u123456789_ardoise
DB_PASSWORD=TU_PASSWORD_MYSQL

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Hostinger mailbox SMTP (buzón soporte)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=soporte.dawzss@dawzss.com
MAIL_PASSWORD=TU_PASSWORD_DEL_BUZON
MAIL_FROM_ADDRESS="soporte.dawzss@dawzss.com"
MAIL_FROM_NAME="Ardoise Soporte"

# Frontend React (origen de producción)
# Enlace de recuperación: {FRONTEND_URL}/reset-password?token=...&email=...
FRONTEND_URL=https://ardoise.dawzss.com

# Orígenes CORS permitidos (separados por coma, sin espacios). Bearer only.
# localhost/127.0.0.1 se permiten también desde config/cors.php (Vite local).
CORS_ALLOWED_ORIGINS=https://ardoise.dawzss.com,https://ardoise-info.dawzss.com,http://localhost:5173,http://127.0.0.1:5173

# Stripe LIVE (Dashboard → Developers → API keys / Webhooks)
STRIPE_KEY=pk_live_XXXXXXXX
STRIPE_SECRET=sk_live_XXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXX
STRIPE_CURRENCY=mxn
# Días de prueba al suscribirse (14, 7, 3...). Usa 0 para desactivar.
STRIPE_TRIAL_DAYS=14
# Price IDs de Stripe (Dashboard → Products → Prices)
STRIPE_PRICE_STANDARD_MENSUAL=price_1U9qQZQMCZvDbFTHnUAMRc4u
STRIPE_PRICE_STANDARD_ANUAL=price_1U9qXhQMCZvDbFTHIKDk6Ban
STRIPE_PRICE_PLUS_MENSUAL=price_1UAz4LQMCZvDbFTHmXAXGI2m
STRIPE_PRICE_PLUS_ANUAL=price_1UAz6uQMCZvDbFTH4w3cj16q
# Legacy (opcional)
STRIPE_PRICE_PRUEBA=
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_ANUAL=
