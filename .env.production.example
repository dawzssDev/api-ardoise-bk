# =============================================================================
# .env.production.example — Hostinger Cloud Startup (api-ardoise.dawzss.com)
# =============================================================================
# Uso: cp .env.production.example .env  y completa los placeholders.
# Nunca subas el .env real al repositorio.
# =============================================================================

APP_NAME=Ardoise
APP_ENV=production
APP_KEY=
# Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api-ardoise.dawzss.com
APP_TIMEZONE=America/Mazatlan

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL (credenciales de hPanel → Databases) ---
# En Hostinger el host suele ser 127.0.0.1 o localhost.
# database/username tienen prefijo tipo u123456789_...
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_ardoise
DB_USERNAME=u123456789_ardoise
DB_PASSWORD=TU_PASSWORD_MYSQL

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ardoise.dawzss.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend React (origen de producción)
FRONTEND_URL=https://ardoise.dawzss.com

# Orígenes CORS permitidos (separados por coma). Sin cookies / Bearer only.
CORS_ALLOWED_ORIGINS=https://ardoise.dawzss.com

# Stripe LIVE (Dashboard → Developers → API keys / Webhooks)
STRIPE_KEY=pk_live_XXXXXXXX
STRIPE_SECRET=sk_live_XXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXX
STRIPE_CURRENCY=mxn
# Días de prueba al suscribirse (14, 7, 3...). Usa 0 para desactivar.
STRIPE_TRIAL_DAYS=14
# Price IDs de Stripe (Dashboard → Products → Prices)
STRIPE_PRICE_PRUEBA=price_XXXXXXXX
STRIPE_PRICE_MENSUAL=price_XXXXXXXX
STRIPE_PRICE_ANUAL=price_XXXXXXXX
